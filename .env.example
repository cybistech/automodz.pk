APP_NAME="AutoModz"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://automodz.pk

SITE_NAME="AutoModz"
SITE_DOMAIN=automodz.pk
SITE_URL=https://automodz.pk
SITE_EMAIL=info@automodz.pk

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=7
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=automodz
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@automodz.pk"
MAIL_FROM_NAME="${APP_NAME}"

# Payment Configuration
PAYMENT_CURRENCY=PKR

# Stripe (https://stripe.com)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# JazzCash (https://sandbox.jazzcash.com.pk)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=
JAZZCASH_SANDBOX=true

# Bank Transfer Details
BANK_NAME="Meezan Bank"
BANK_ACCOUNT_TITLE="AutoModz"
BANK_ACCOUNT_NUMBER=
BANK_IBAN=
BANK_BRANCH="Main Branch, Karachi"

VITE_APP_NAME="${APP_NAME}"

# SSO (Google / Facebook)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"
