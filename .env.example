APP_NAME="AutoModz"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://automodz.pk

SITE_NAME="AutoModz"
SITE_DOMAIN=automodz.pk
SEO_DEFAULT_OG_IMAGE=/images/og-image.jpg

SITE_EMAIL=info@automodz.pk

SHIPPING_ORIGIN_CITY=Lahore

SITE_OFFICE_CITY=Lahore
SITE_OFFICE_COUNTRY=Pakistan
SITE_WHATSAPP=923124094997
SITE_WHATSAPP_DISPLAY="+92 312 4094997"
SITE_WHATSAPP_MESSAGE="Hello AutoModz.pk! I need help with an order or product inquiry."

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,errorlog
LOG_DAILY_DAYS=7
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=automodz
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@automodz.pk"
MAIL_FROM_NAME="${APP_NAME}"

# Payment Configuration
PAYMENT_CURRENCY=PKR

# EasyPaisa
EASYPAISA_ACCOUNT_TITLE="AutoModz"
EASYPAISA_ACCOUNT_NUMBER=

# SEO / Sitemaps
SITEMAP_CACHE_MINUTES=60
GOOGLE_SITE_VERIFICATION=
SEO_FEED_ITEMS=50

VITE_APP_NAME="${APP_NAME}"
